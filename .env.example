# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required for the agent step.
# If you use `ant auth login` instead, you can leave the key unset.
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# AGENT_MAX_TOKENS=16000
# AGENT_MAX_TURNS=40

# Terminology suggestions (Termbox MCP). Defaults work out of the box; no auth needed.
# TERMBOX_MCP_URL=https://tx.health-samurai.io/mcp/sse
# TERMBOX_TIMEOUT=30
# TERMBOX_DEFAULT_TARGETS=http://snomed.info/sct,http://loinc.org
# TERMBOX_MAX_QUERIES=5
# TERMBOX_MIN_SCORE=0.35

# Aidbox FHIR server (needed only for the live "Load to Aidbox" migration step).
# Create a Client + AccessPolicy in Aidbox (see docs), then set its id/secret.
# AIDBOX_BASE_URL=https://your-instance.aidbox.app
# AIDBOX_CLIENT_ID=
# AIDBOX_CLIENT_SECRET=
# or a pre-issued bearer token instead of client id/secret:
# AIDBOX_TOKEN=
# AIDBOX_INSECURE=0        # set to 1 only for a demo box with a self-signed/flaky cert
# AIDBOX_BUNDLE_SIZE=100
# AIDBOX_TIMEOUT=60
